{
  "name": "sarkiai-policy-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Policy-grounded multi-agent engine for the ITU AI for Good Lab Hackathon (UAE)",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
