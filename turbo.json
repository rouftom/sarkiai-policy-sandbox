{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "MONGODB_URI",
    "MONGODB_DB_NAME",
    "QDRANT_URL",
    "QDRANT_API_KEY",
    "QDRANT_COLLECTION",
    "OLLAMA_BASE_URL",
    "OLLAMA_MODEL",
    "EMBEDDING_MODEL",
    "RERANK_URL",
    "RERANK_MODEL",
    "INGESTION_URL",
    "TRANSCRIPTION_URL",
    "OCR_URL",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "SERVICE_API_KEY",
    "MCP_CHARTS_URL",
    "MCP_DOCX_URL",
    "MCP_API_KEY",
    "SESSION_SECRET",
    "APPROVAL_SECRET",
    "MAIL_FROM",
    "MAIL_REPLY_TO",
    "WEB_PUBLIC_URL",
    "WEB_PUBLIC_URL_ALIASES",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_WEB_URL",
    "NEXT_PUBLIC_WEB_ORIGINS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
