# Self-hosted reference deployment — variables.
# Copy to `.env.sandbox` next to the compose file's working directory and fill
# in. Never commit real values.

# ── Local models (Ollama) — LLM + embeddings. No cloud provider. ─────────────
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3.5:9b
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
# Enable the local TEI reranker (`--profile rerank`) or leave empty for RRF-only.
RERANK_URL=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ── Vector knowledge base (Qdrant, bundled) ─────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=policy_chunks

# ── Operational store (MongoDB, bundled) ────────────────────────────────────
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=policy_sandbox

# ── Object storage (MinIO) for assistant image attachments ──────────────────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=sps-attachments
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Local transcription (faster-whisper) ────────────────────────────────────
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── Local OCR (Tesseract) ───────────────────────────────────────────────────
OCR_LANGUAGES=fra+eng

# ── Local MCP servers (charts + Word documents) ─────────────────────────────
MCP_API_KEY=

# ── Shared secret between the API and the Python services ───────────────────
SERVICE_API_KEY=

# ── Operator auth, sessions and signed approvals ────────────────────────────
# openssl rand -hex 32
SESSION_SECRET=
APPROVAL_SECRET=
AUTH_SIGNUP=false

# ── Console e-mail (log + outbox only; no SMTP) ─────────────────────────────
MAIL_FROM=SarkiAI Policy Sandbox <sandbox@localhost>
MAIL_REPLY_TO=

# ── Public origins ──────────────────────────────────────────────────────────
# The reverse proxy terminates TLS; these are the origins it forwards.
WEB_PUBLIC_URL=https://console.policy-sandbox.example
WEB_PUBLIC_URL_ALIASES=
NEXT_PUBLIC_WEB_URL=https://console.policy-sandbox.example
NEXT_PUBLIC_API_URL=https://api.policy-sandbox.example
NEXT_PUBLIC_WEB_ORIGINS=

# ── Image registry + tag (leave unset to build locally) ─────────────────────
SPS_REGISTRY=sarkiai
SPS_TAG=local
