# SOPS-encrypted env is safe to commit; the age private key is not.
!.env.enc
secrets/
*.age.key
age.key

# Knowledge-base payloads: ignored by default; the documents cleared for
# redistribution are re-included at the end of this file (see
# data/KNOWLEDGE-BASE.md). Structure stays visible via .gitkeep + manifests.
data/country/*/*
!data/country/*/.gitkeep
!data/country/**/manifest.json
!data/country/**/README.md
data/global/*/*
!data/global/*/.gitkeep
!data/global/**/manifest.json
!data/global/**/dimensions.json
!data/global/**/*.txt
*.pdf
*.docx
!submission/TECHNICAL-REPORT.pdf
!submission/TECHNICAL-REPORT.docx

# docker / os
.docker/
.DS_Store
*.log
coverage/

# deployment metadata
.vercel

# Self-hosted reference deployment secrets
deploy/sandbox/.env.sandbox

# Knowledge base: Cameroon documents published with the repository.
# Only official texts and openly licensed public-body publications (rights:
# official-text or open-licence in data/country/cm/manifest.json) are listed.
# Press articles, authored papers and documents whose terms are unconfirmed
# stay local; `make check-kb` enforces the rule.
