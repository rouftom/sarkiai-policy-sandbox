# ─────────────────────────────────────────────────────────────────────────────
# SarkiAI Policy Sandbox — environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Vector knowledge base (Qdrant) ───────────────────────────────────────────
# Local docker exposes Qdrant on 6333. On the ITU sandbox, point at the
# Qdrant instance/endpoint provided by the Lab.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=policy_chunks
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ── Operational store (audit + chain-of-thought; NO vectors) ────────────────
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=policy_sandbox
MONGO_PORT=27017

# ── Embeddings (VoyageAI) ────────────────────────────────────────────────────
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=128

# ── LLM providers (set at least one; DeepSeek is the default) ────────────────
DEFAULT_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Chunking ─────────────────────────────────────────────────────────────────
DEFAULT_CHUNK_SIZE=900
DEFAULT_CHUNK_OVERLAP=120

# ── Services ─────────────────────────────────────────────────────────────────
INGESTION_URL=http://ingestion:8000
OCR_URL=http://ocr:8000
TRANSCRIPTION_URL=http://transcription:8000
API_PORT=8000
WEB_PORT=3000
INGESTION_PORT=8001
OCR_PORT=8002
TRANSCRIPTION_PORT=8003

# ── Shared secret between API and Python services ────────────────────────────
SERVICE_API_KEY=change-me-service-key

# ── Audit / CoT trace ────────────────────────────────────────────────────────
AUDIT_ENABLED=true
COT_TRACE_ENABLED=true
